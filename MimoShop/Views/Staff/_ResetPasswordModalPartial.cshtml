@model ResetPasswordViewModel

<div class="modal fade" id="staffResetModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="ResetPassword" method="post" data-modal-form>
                <div class="modal-header">
                    <h5 class="modal-title">إعادة تعيين كلمة المرور</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input asp-for="Username" type="hidden" />
                    <input asp-for="DisplayName" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary"></div>
                    <p class="text-muted">تعيين كلمة مرور جديدة للحساب <strong>@Model.DisplayName</strong> (<span dir="ltr">@Model.Username</span>).</p>
                    <div class="form-grid form-grid--1">
                        <div class="form-field">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" dir="ltr" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        <div class="form-field">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" dir="ltr" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">تعيين كلمة المرور</button>
                </div>
            </form>
        </div>
    </div>
</div>
