@inject RepairWorkflowService RepairWorkflow
@inject ShopSettingsService ShopSettings
@using MimoShop.Models
@using MimoShop.Services
@{
    RepairTicketListViewModel? layoutList = null;
    ShopSetting? shopSettings = null;
    try
    {
        layoutList = await RepairWorkflow.GetTicketListAsync();
        shopSettings = await ShopSettings.GetSettingsAsync();
    }
    catch
    {
        layoutList = null;
    }
    string shopName = shopSettings?.Name ?? "ميمو شوب";
    string shopLatin = shopSettings?.LatinName ?? "MimoShop";
    char brandMark = shopLatin.Length > 0 ? shopLatin[0] : 'M';
    string? shopLogoUrl = string.IsNullOrWhiteSpace(shopSettings?.LogoUrl) ? null : shopSettings!.LogoUrl;
    int waitingCount = layoutList?.WaitingForPartJobs?.Count ?? 0;
    string currentController = (string?)ViewContext.RouteData.Values["controller"] ?? string.Empty;
    string currentAction = (string?)ViewContext.RouteData.Values["action"] ?? string.Empty;
    bool isActive(string controller, string action = "Index") =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    bool isRepairArea = string.Equals(currentController, "RepairTickets", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "Details", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "Receipt", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - @shopLatin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Tajawal:wght@500;700;800&display=swap">
    <link rel="stylesheet" href="@Url.Content("~/lib/bootstrap/dist/css/bootstrap.rtl.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/lib/tom-select/tom-select.default.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
    <link rel="manifest" href="@Url.Content("~/manifest.json")" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="MimoShop">
    <meta name="theme-color" content="#0f766e">
</head>
<body>
    <button type="button" class="app-hamburger" aria-label="فتح القائمة" aria-controls="app-sidebar" aria-expanded="false">
        <span class="app-hamburger__bars" aria-hidden="true">
            <span></span><span></span><span></span>
        </span>
    </button>

    <div class="app-drawer-backdrop" hidden></div>

    <div class="app-drawer-edge" aria-hidden="true"></div>

    <nav class="app-bottom-nav" aria-label="التنقل السريع">
        <a class="bottom-nav-item @(isRepairArea ? "bottom-nav-item--active" : "")"
           asp-controller="RepairTickets" asp-action="Index" aria-label="الحالات" title="الحالات">
            <span class="bottom-nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                    <path d="M9 4v3M15 4v3M9 17h6M9 13h6M9 9h2" />
                </svg>
            </span>
            <span class="bottom-nav-item__label">الحالات</span>
        </a>
        <a class="bottom-nav-item @(isActive("Inventory") ? "bottom-nav-item--active" : "")"
           asp-controller="Inventory" asp-action="Index" aria-label="المخزون" title="المخزون">
            <span class="bottom-nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 8 12 3 3 8v8l9 5 9-5z" />
                    <path d="M3.3 8.5 12 13l8.7-4.5M12 22V13" />
                </svg>
            </span>
            <span class="bottom-nav-item__label">المخزون</span>
        </a>
        <a class="bottom-nav-item @(isActive("Categories") ? "bottom-nav-item--active" : "")"
           asp-controller="Categories" asp-action="Index" aria-label="التصنيفات" title="التصنيفات">
            <span class="bottom-nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.6 12.6 12 21l-9-9V3h9z" />
                    <circle cx="7.5" cy="7.5" r="1.5" />
                </svg>
            </span>
            <span class="bottom-nav-item__label">التصنيفات</span>
        </a>
    </nav>

    <div class="app-shell">
        <aside id="app-sidebar" class="app-sidebar" aria-label="القائمة الرئيسية">
            <button type="button" class="sidebar-toggle" data-sidebar-toggle
                    aria-label="طيّ القائمة" aria-controls="app-sidebar" aria-expanded="true" title="طيّ القائمة">
                <svg class="sidebar-toggle__collapse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 6l-6 6 6 6" />
                </svg>
                <svg class="sidebar-toggle__expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 6l6 6-6 6" />
                </svg>
            </button>

            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                @if (shopLogoUrl is not null)
                {
                    <img src="@Url.Content(shopLogoUrl)" alt="@shopLatin" class="sidebar-brand__logo" asp-append-version="true" />
                }
                else
                {
                    <span class="sidebar-brand__mark" aria-hidden="true">@brandMark</span>
                }
                <span class="sidebar-brand__text">
                    <span class="sidebar-brand__name">@shopLatin</span>
                    <span class="sidebar-brand__sub">@shopName</span>
                </span>
            </a>

            <div class="sidebar-scroll">
                <div class="sidebar-section">
                    <p class="sidebar-section__label">العمليات</p>
                    <ul class="sidebar-nav">
                        <li>
                            <a class="nav-item @(isRepairArea ? "nav-item--active" : "")"
                               asp-controller="RepairTickets" asp-action="Index">
                                <span class="nav-item__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="4" y="4" width="16" height="16" rx="2" />
                                        <path d="M9 4v3M15 4v3M9 17h6M9 13h6M9 9h2" />
                                    </svg>
                                </span>
                                <span class="nav-item__label">الحالات</span>
                                <span class="nav-badge @(waitingCount == 0 ? "nav-badge--zero" : "")" title="بانتظار قطعة">@waitingCount</span>
                            </a>
                        </li>
                        <li>
                            <a class="nav-item @(isActive("Inventory") ? "nav-item--active" : "")"
                               asp-controller="Inventory" asp-action="Index">
                                <span class="nav-item__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 8 12 3 3 8v8l9 5 9-5z" />
                                        <path d="M3.3 8.5 12 13l8.7-4.5M12 22V13" />
                                    </svg>
                                </span>
                                <span class="nav-item__label">المخزون</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-section">
                    <p class="sidebar-section__label">الإدارة</p>
                    <ul class="sidebar-nav">
                        <li>
                            <a class="nav-item @(isActive("Categories") ? "nav-item--active" : "")"
                               asp-controller="Categories" asp-action="Index">
                                <span class="nav-item__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20.6 12.6 12 21l-9-9V3h9z" />
                                        <circle cx="7.5" cy="7.5" r="1.5" />
                                    </svg>
                                </span>
                                <span class="nav-item__label">التصنيفات</span>
                            </a>
                        </li>
                        <li>
                            <button type="button" class="nav-item" data-open-modal="shopSettings">
                                <span class="nav-item__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33" />
                                        <path d="M15 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82" />
                                        <path d="M8.6 15a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33" />
                                        <path d="M4.6 8.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82" />
                                    </svg>
                                </span>
                                <span class="nav-item__label">الإعدادات</span>
                            </button>
                        </li>
                        @if (User.IsInRole("Owner") || User.IsInRole("SuperAdmin"))
                        {
                            <li>
                                <a class="nav-item @(isActive("Dashboard") ? "nav-item--active" : "")"
                                   asp-controller="Dashboard" asp-action="Index">
                                    <span class="nav-item__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 21h18" />
                                            <rect x="5" y="13" width="3" height="6" />
                                            <rect x="10.5" y="9" width="3" height="10" />
                                            <rect x="16" y="5" width="3" height="14" />
                                        </svg>
                                    </span>
                                    <span class="nav-item__label">لوحة المالك</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li>
                                <a class="nav-item @(isActive("Staff") ? "nav-item--active" : "")"
                                   asp-controller="Staff" asp-action="Index">
                                    <span class="nav-item__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                            <circle cx="9" cy="7" r="4" />
                                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                        </svg>
                                    </span>
                                    <span class="nav-item__label">المستخدمين</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="sidebar-user">
                <div class="sidebar-user__avatar" aria-hidden="true">
                    @(string.IsNullOrEmpty(User.Identity?.Name) ? "?" : User.Identity!.Name![0].ToString().ToUpperInvariant())
                </div>
                <div class="sidebar-user__meta">
                    <button type="button" class="sidebar-user__name" data-open-modal="shopSettings">@User.Identity?.Name</button>
                    <span class="sidebar-user__role">
                        @(User.IsInRole("SuperAdmin") ? "مدير النظام" : User.IsInRole("Owner") ? "مالك" : "عامل")
                    </span>
                </div>
                <div class="sidebar-user__actions">
                    <button type="button" class="sidebar-user__btn" aria-label="إعدادات المتجر" title="إعدادات المتجر" data-open-modal="shopSettings">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                        </svg>
                    </button>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-user__logout"
                          data-confirm-modal data-confirm-title="تأكيد الخروج"
                          data-confirm-body="هل تريد تسجيل الخروج من النظام؟">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-logout" aria-label="خروج" title="خروج">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                                <path d="M10 17l-5-5 5-5" />
                                <path d="M5 12h12" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="app-content">
            <header class="app-header">
                <div class="app-header__inner">
                    @await Html.PartialAsync("_Breadcrumb")
                </div>
            </header>
            <div class="app-container">
                <div class="page">
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>

            <footer class="app-footer app-footer--console">
                <div class="app-footer__glow" aria-hidden="true"></div>
                <div class="app-footer__ticker" role="status" aria-live="off">
                    <span class="ticker-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/></svg>
                        MODEL · MIMOSHOP-V1.0
                    </span>
                    <span class="ticker-chip ticker-chip--ok">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>
                        DB · CONNECTED
                    </span>
                    <span class="ticker-chip ticker-chip--live">
                        <span class="ticker-chip__dot" aria-hidden="true"></span>
                        BOT · ACTIVE
                    </span>
                    <span class="ticker-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.5a3.5 3.5 0 1 0 0 5"/><path d="M8 12h.01"/></svg>
                        CURRENCY · DZD
                    </span>
                </div>
                <div class="app-footer__inner">
                    <div class="app-footer__col app-footer__col--brand">
                        <div class="app-footer__logo-wrap">
                            @if (shopLogoUrl is not null)
                            {
                                <img src="@Url.Content(shopLogoUrl)" alt="@shopLatin" class="app-footer__logo-img" asp-append-version="true" />
                            }
                            else
                            {
                                <span class="app-footer__logo" aria-hidden="true">@brandMark</span>
                            }
                            <div class="app-footer__brand-info">
                                <span class="app-footer__name">@shopLatin CORE</span>
                                <span class="app-footer__desc">نظام إدارة الصيانة الذكي</span>
                            </div>
                        </div>
                        <span class="app-footer__sub">OPERATIONS PORTAL</span>
                    </div>

                    <div class="app-footer__col app-footer__col--status">
                        <span class="app-footer__section-title">SYSTEM STATUS</span>
                        <div class="app-footer__status-item">
                            <span class="app-footer__status-dot" aria-hidden="true"></span>
                            <span>البوابة متصلة وتعمل بكفاءة</span>
                        </div>
                        <div class="app-footer__status-item">
                            <span class="app-footer__status-dot-sub" aria-hidden="true"></span>
                            <span>قاعدة البيانات مستقرة</span>
                        </div>
                    </div>

                    <div class="app-footer__col app-footer__col--links">
                        <span class="app-footer__section-title">QUICK ACCESS</span>
                        <div class="app-footer__links-row">
                            <a class="app-footer__link" asp-controller="Home" asp-action="Index">دليل الاستخدام</a>
                            <a class="app-footer__link" asp-controller="ShopSettings" asp-action="Index">الدعم الفني</a>
                        </div>
                        <span class="app-footer__copy">&copy; @DateTime.Now.Year · @shopLatin · ALL RIGHTS RESERVED</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
    <script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/lib/tom-select/tom-select.complete.min.js")"></script>
    <script src="@Url.Content("~/js/site.js")" asp-append-version="true"></script>

    <div class="modal fade" id="mimo-confirm-modal" tabindex="-1" role="dialog" aria-hidden="true" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-confirm-title>تأكيد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <p data-confirm-body>هل أنت متأكد؟</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-primary" data-confirm-ok>تأكيد</button>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ModalHost")

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
