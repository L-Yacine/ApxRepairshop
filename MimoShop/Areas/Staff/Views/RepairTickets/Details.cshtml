@section Scripts {
    <script>
        (() => {
            const pmModal = document.getElementById("repairPaymentModal");
            const pmEst = pmModal?.querySelector("[data-pm-estimated]");
            const pmPaid = pmModal?.querySelector("[data-pm-paid]");
            document.querySelectorAll("[data-pm-trigger]").forEach(btn => {
                btn.addEventListener("click", () => {
                    if (!pmModal || !window.bootstrap) return;
                    pmEst.value = btn.getAttribute("data-pm-estimated") ?? "";
                    pmPaid.value = btn.getAttribute("data-pm-paid") ?? "";
                    const readonly = btn.getAttribute("data-pm-readonly") === "true";
                    pmEst.readOnly = readonly;
                    pmEst.style.opacity = readonly ? "0.65" : "";
                    bootstrap.Modal.getOrCreateInstance(pmModal).show();
                });
            });

            document.querySelectorAll(".part-type-tabs").forEach(tabRow => {
                const variants = tabRow.parentElement.querySelector("[data-variants-container]");
                const form = tabRow.closest("form");
                const partInput = form?.querySelector("[data-part-input]");

                tabRow.addEventListener("click", e => {
                    const tab = e.target.closest(".part-type-tab");
                    if (!tab || tab.classList.contains("is-active")) return;

                    tabRow.querySelectorAll(".part-type-tab").forEach(t => {
                        t.classList.remove("is-active");
                        t.setAttribute("aria-selected", "false");
                    });
                    tab.classList.add("is-active");
                    tab.setAttribute("aria-selected", "true");

                    if (variants) {
                        const typeId = tab.getAttribute("data-part-type-id");
                        variants.querySelectorAll("[data-variant-group]").forEach(g => {
                            g.style.display = g.getAttribute("data-variant-group") === typeId ? "" : "none";
                        });
                    }

                    if (partInput) partInput.value = "";
                });

                if (variants) {
                    variants.addEventListener("click", e => {
                        const card = e.target.closest(".part-variant-card");
                        if (!card) return;

                        const group = card.closest("[data-variant-group]");
                        group.querySelectorAll(".part-variant-card").forEach(c => c.classList.remove("is-selected"));
                        card.classList.add("is-selected");
                        if (partInput) partInput.value = card.getAttribute("data-part-id");
                    });
                }
            });
        })();
    </script>
}