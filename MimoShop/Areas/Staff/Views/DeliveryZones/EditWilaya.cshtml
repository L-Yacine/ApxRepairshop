@model WilayaFormInput
@{
    ViewData["Title"] = "تعديل الولاية";
}

<section class="page-header">
    <p class="page-header__eyebrow">مناطق التوصيل</p>
    <h1 class="page-header__title">تعديل الولاية</h1>
</section>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="EditWilaya" method="post" class="dz-form">
    @Html.AntiForgeryToken()
    <div class="form-grid form-grid--3">
        <div class="form-field">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="form-control" maxlength="2" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-field">
            <label asp-for="NameAr"></label>
            <input asp-for="NameAr" class="form-control" />
            <span asp-validation-for="NameAr" class="text-danger"></span>
        </div>
        <div class="form-field">
            <label asp-for="NameFr"></label>
            <input asp-for="NameFr" class="form-control" dir="ltr" />
            <span asp-validation-for="NameFr" class="text-danger"></span>
        </div>
        <div class="form-field">
            <label asp-for="ShippingFee"></label>
            <input asp-for="ShippingFee" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="ShippingFee" class="text-danger"></span>
        </div>
        <div class="form-field form-field--check">
            <label asp-for="IsActive">
                <input asp-for="IsActive" /> @Html.DisplayNameFor(m => m.IsActive)
            </label>
        </div>
    </div>

    <p class="dz-form__hint">تغيير رسوم التوصيل يؤثر فقط على الطلبات الجديدة. الطلبات السابقة تحتفظ بالرسوم المسجلة عند إنشائها.</p>

    <div class="dz-form__actions">
        <button type="submit" class="btn btn-primary">حفظ</button>
        <a asp-action="Index" asp-route-selectedWilayaId="@Context.GetRouteValue("id")" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>