<div class="image-fetch-modal" data-image-fetch-modal hidden>
    <div class="image-fetch-modal__backdrop" data-image-fetch-close></div>
    <section class="image-fetch-dialog" role="dialog" aria-modal="true" aria-labelledby="image-fetch-title">
        <div class="image-fetch-dialog__header">
            <div>
                <p class="image-fetch-dialog__eyebrow">GSMArena</p>
                <h2 id="image-fetch-title" class="image-fetch-dialog__title">جلب صورة موديل</h2>
            </div>
            <button type="button" class="btn btn-outline-secondary btn--sm" data-image-fetch-close>إغلاق</button>
        </div>
        <div class="image-fetch-dialog__body">
            <div class="image-fetch-search">
                <input type="search" class="form-control" data-image-fetch-query aria-label="بحث عن صورة موديل" />
                <button type="button" class="btn btn-primary" data-image-fetch-search>بحث</button>
            </div>
            <p class="form-hint" data-image-fetch-status>اختر نتيجة واحدة بعد مراجعة الصورة والاسم.</p>
            <div class="image-fetch-results" data-image-fetch-results></div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            // Tab switching logic
            const tabButtons = document.querySelectorAll(".cat-tab-btn");
            const tabContents = document.querySelectorAll(".cat-tab-content");

            function showTab(target) {
                tabButtons.forEach(btn => {
                    if (btn.getAttribute("data-target") === target) {
                        btn.classList.add("is-active");
                        btn.setAttribute("aria-selected", "true");
                    } else {
                        btn.classList.remove("is-active");
                        btn.setAttribute("aria-selected", "false");
                    }
                });

                tabContents.forEach(content => {
                    if (content.id === "tab-" + target) {
                        content.style.display = "block";
                    } else {
                        content.style.display = "none";
                    }
                });

                localStorage.setItem("mimo_categories_active_tab", target);
            }

            tabButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    const target = btn.getAttribute("data-target");
                    showTab(target);
                });
            });

            const savedTab = localStorage.getItem("mimo_categories_active_tab") || "brands";
            if (document.querySelector(`[data-target="${savedTab}"]`)) {
                showTab(savedTab);
            } else {
                showTab("brands");
            }

            // Client-side search filtering
            const searchInputs = document.querySelectorAll("[data-search-input]");
            searchInputs.forEach(input => {
                input.addEventListener("input", (e) => {
                    const query = e.target.value.toLowerCase().trim();
                    const tabContent = e.target.closest(".cat-tab-content");
                    const listItems = tabContent.querySelectorAll("[data-search-item]");
                    const emptyState = tabContent.querySelector(".cat-empty-state");
                    let matchCount = 0;

                    listItems.forEach(item => {
                        const searchText = item.getAttribute("data-search-item") || "";
                        if (searchText.indexOf(query) !== -1) {
                            item.style.display = "grid";
                            matchCount++;
                        } else {
                            item.style.display = "none";
                        }
                    });

                    if (emptyState) {
                        emptyState.style.display = (matchCount === 0 && query !== "") ? "flex" : "none";
                    }
                });
            });

            // === Category entity modal helper ===
            const TAB_META = {
                brands: { modalId: "catBrandModal",      createUrl: '@Url.Action("CreateBrand", "Categories")',       createTitle: "إضافة علامة جديدة",   createSubmit: "إضافة علامة",  editUrl: (id) => `@Url.Action("UpdateBrand", "Categories")/${id}`,       entityName: "العلامة" },
                models: { modalId: "catModelModal",      createUrl: '@Url.Action("CreatePhoneModel", "Categories")',  createTitle: "إضافة موديل جديد",  createSubmit: "إضافة موديل", editUrl: (id) => `@Url.Action("UpdatePhoneModel", "Categories")/${id}`,  entityName: "الموديل" },
                types:  { modalId: "catTypeModal",       createUrl: '@Url.Action("CreatePartType", "Categories")',    createTitle: "إضافة نوع قطعة جديد", createSubmit: "إضافة نوع",   editUrl: (id) => `@Url.Action("UpdatePartType", "Categories")/${id}`,    entityName: "نوع القطعة" },
                variants: { modalId: "catVariantModal", createUrl: '@Url.Action("CreatePartVariant", "Categories")', createTitle: "إضافة نوعية جديدة",  createSubmit: "إضافة نوعية",  editUrl: (id) => `@Url.Action("UpdatePartVariant", "Categories")/${id}`,  entityName: "النوعية" }
            };

            function getModalEl(tabId) {
                const meta = TAB_META[tabId];
                return meta ? document.getElementById(meta.modalId) : null;
            }

            function getBootstrapModal(tabId) {
                const el = getModalEl(tabId);
                return el ? bootstrap.Modal.getOrCreateInstance(el) : null;
            }

            function resetToCreate(tabId) {
                const meta = TAB_META[tabId];
                const el = getModalEl(tabId);
                if (!el || !meta) return;
                const form = el.querySelector("[data-form]");
                const card = el; // .modal-content has data-form-card
                const submitBtn = card.querySelector("[data-submit-btn]");
                const cancelBtn = card.querySelector("[data-cancel-btn]");
                const cardTitle = card.querySelector("[data-card-title]");

                form.reset();
                form.action = meta.createUrl;
                form.removeAttribute("data-editing-id");
                if (cardTitle) cardTitle.textContent = meta.createTitle;
                if (submitBtn) submitBtn.textContent = meta.createSubmit;
                if (cancelBtn) cancelBtn.style.display = "none";
                card.classList.remove("cat-form-card--editing");
            }

            function switchToEdit(tabId, btn) {
                const meta = TAB_META[tabId];
                const el = getModalEl(tabId);
                if (!el || !meta) return;
                const card = el;
                const form = card.querySelector("[data-form]");

                const id = btn.getAttribute("data-id");
                const name = btn.getAttribute("data-name");
                const displayAr = btn.getAttribute("data-display-ar");
                const sortOrder = btn.getAttribute("data-sort-order");
                const isActive = btn.getAttribute("data-is-active") === "true";
                const brandId = btn.getAttribute("data-brand-id");

                const inputLatin = card.querySelector("[data-val-latin]");
                const inputAr = card.querySelector("[data-val-ar]");
                const inputSort = card.querySelector("[data-val-sort]");
                const inputActive = card.querySelector("[data-val-active]");
                const selectBrand = card.querySelector("[data-val-brand]");

                if (inputLatin) inputLatin.value = name;
                if (inputAr) inputAr.value = displayAr;
                if (inputSort) inputSort.value = sortOrder;
                if (inputActive) inputActive.checked = isActive;
                if (selectBrand && brandId) selectBrand.value = brandId;

                const submitBtn = card.querySelector("[data-submit-btn]");
                const cancelBtn = card.querySelector("[data-cancel-btn]");
                const cardTitle = card.querySelector("[data-card-title]");

                card.classList.add("cat-form-card--editing");
                if (cancelBtn) cancelBtn.style.display = "inline-flex";
                if (cardTitle) cardTitle.textContent = `تعديل ${meta.entityName}: ${name}`;
                if (submitBtn) submitBtn.textContent = "حفظ التعديل";
                form.action = meta.editUrl(id);
                form.setAttribute("data-editing-id", id);
            }

            // Add buttons
            document.querySelectorAll("[data-cat-add]").forEach(btn => {
                btn.addEventListener("click", () => {
                    const tabId = btn.getAttribute("data-cat-tab");
                    resetToCreate(tabId);
                    getBootstrapModal(tabId).show();
                });
            });

            // Edit buttons
            document.querySelectorAll("[data-edit-btn]").forEach(btn => {
                btn.addEventListener("click", () => {
                    const tabId = btn.getAttribute("data-cat-tab");
                    switchToEdit(tabId, btn);
                    getBootstrapModal(tabId).show();
                });
            });

            // Cancel-edit buttons inside modals
            document.querySelectorAll("[data-cancel-btn]").forEach(btn => {
                btn.addEventListener("click", () => {
                    const card = btn.closest("[data-form-card]");
                    const tabId = card?.getAttribute("data-cat-modal-tab");
                    if (!tabId) return;
                    resetToCreate(tabId);
                });
            });

            // When modal closes via backdrop/X, also reset to create mode for next open.
            Object.keys(TAB_META).forEach(tabId => {
                const el = getModalEl(tabId);
                if (!el) return;
                el.addEventListener("hidden.bs.modal", () => resetToCreate(tabId));
            });

            const imageFetchModal = document.querySelector("[data-image-fetch-modal]");
            const imageFetchQuery = document.querySelector("[data-image-fetch-query]");
            const imageFetchStatus = document.querySelector("[data-image-fetch-status]");
            const imageFetchResults = document.querySelector("[data-image-fetch-results]");
            const imageFetchSearch = document.querySelector("[data-image-fetch-search]");
            const imageFetchToken = document.querySelector("input[name='__RequestVerificationToken']")?.value || "";
            let activePhoneModelId = "";
            let activeModelRow = null;

            function setImageFetchStatus(message, isError) {
                if (!imageFetchStatus) return;
                imageFetchStatus.textContent = message;
                imageFetchStatus.classList.toggle("image-fetch-dialog__status--error", Boolean(isError));
            }

            function openImageFetchModal(button) {
                activePhoneModelId = button.getAttribute("data-id") || "";
                activeModelRow = button.closest(".cat-row");
                const modelName = button.getAttribute("data-model-name") || "";
                const brandName = button.getAttribute("data-brand-name") || "";
                const defaultQuery = `${brandName} ${modelName}`.trim();

                imageFetchQuery.value = defaultQuery;
                imageFetchResults.innerHTML = "";
                setImageFetchStatus("اختر نتيجة واحدة بعد مراجعة الصورة والاسم.", false);
                imageFetchModal.hidden = false;
                document.body.classList.add("modal-open");
                imageFetchQuery.focus();
                searchPhoneImages();
            }

            function closeImageFetchModal() {
                imageFetchModal.hidden = true;
                document.body.classList.remove("modal-open");
                activePhoneModelId = "";
                activeModelRow = null;
            }

            async function searchPhoneImages() {
                const query = imageFetchQuery.value.trim();
                if (!activePhoneModelId || !query) {
                    setImageFetchStatus("أدخل اسم الموديل للبحث.", true);
                    return;
                }

                imageFetchSearch.disabled = true;
                imageFetchResults.innerHTML = "";
                setImageFetchStatus("جاري البحث...", false);

                try {
                    const url = `@Url.Action("SearchPhoneModelImages", "Categories")/${encodeURIComponent(activePhoneModelId)}?query=${encodeURIComponent(query)}`;
                    const response = await fetch(url, { headers: { "Accept": "application/json" } });
                    if (!response.ok) {
                        throw new Error("search_failed");
                    }

                    const candidates = await response.json();
                    renderImageCandidates(candidates);
                    setImageFetchStatus(candidates.length ? "راجع النتائج واختر الصورة المطابقة." : "لا توجد نتائج لهذا البحث.", !candidates.length);
                } catch {
                    setImageFetchStatus("تعذر البحث الآن. جرّب مرة أخرى.", true);
                } finally {
                    imageFetchSearch.disabled = false;
                }
            }

            function renderImageCandidates(candidates) {
                imageFetchResults.innerHTML = "";

                candidates.forEach(candidate => {
                    const card = document.createElement("button");
                    card.type = "button";
                    card.className = "image-fetch-card";

                    const image = document.createElement("img");
                    image.src = candidate.imageUrl;
                    image.alt = candidate.title;
                    image.loading = "lazy";

                    const title = document.createElement("span");
                    title.className = "image-fetch-card__title";
                    title.textContent = candidate.title;

                    const source = document.createElement("span");
                    source.className = "image-fetch-card__source";
                    source.textContent = candidate.sourceName;

                    card.append(image, title, source);
                    card.addEventListener("click", () => applyPhoneImage(candidate.sourceUrl, card));
                    imageFetchResults.appendChild(card);
                });
            }

            async function applyPhoneImage(sourceUrl, selectedCard) {
                if (!activePhoneModelId || !sourceUrl) return;

                const cards = imageFetchResults.querySelectorAll(".image-fetch-card");
                cards.forEach(card => card.disabled = true);
                selectedCard.classList.add("image-fetch-card--selected");
                setImageFetchStatus("جاري حفظ الصورة...", false);

                const formData = new FormData();
                formData.append("__RequestVerificationToken", imageFetchToken);
                formData.append("id", activePhoneModelId);
                formData.append("sourceUrl", sourceUrl);

                try {
                    const response = await fetch('@Url.Action("ApplyPhoneModelImage", "Categories")', {
                        method: "POST",
                        body: formData,
                        headers: { "Accept": "application/json" }
                    });
                    const data = await response.json();
                    if (!response.ok) {
                        throw new Error(data.message || "تعذر حفظ الصورة.");
                    }

                    if (activeModelRow && data.thumbnailUrl) {
                        const thumb = activeModelRow.querySelector(".cat-row__thumb");
                        thumb.innerHTML = "";
                        const image = document.createElement("img");
                        image.src = data.thumbnailUrl;
                        image.alt = imageFetchQuery.value.trim();
                        image.loading = "lazy";
                        thumb.appendChild(image);
                    }

                    setImageFetchStatus(data.message || "تم حفظ صورة الموديل.", false);
                    window.setTimeout(closeImageFetchModal, 700);
                } catch (error) {
                    cards.forEach(card => card.disabled = false);
                    selectedCard.classList.remove("image-fetch-card--selected");
                    setImageFetchStatus(error.message || "تعذر حفظ الصورة.", true);
                }
            }

            document.querySelectorAll("[data-image-fetch-btn]").forEach(button => {
                button.addEventListener("click", () => openImageFetchModal(button));
            });

            imageFetchSearch?.addEventListener("click", searchPhoneImages);
            imageFetchQuery?.addEventListener("keydown", event => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    searchPhoneImages();
                }
            });

            document.querySelectorAll("[data-image-fetch-close]").forEach(button => {
                button.addEventListener("click", closeImageFetchModal);
            });

            document.addEventListener("keydown", event => {
                if (event.key === "Escape" && imageFetchModal && !imageFetchModal.hidden) {
                    closeImageFetchModal();
                }
            });
        })();
    </script>
}